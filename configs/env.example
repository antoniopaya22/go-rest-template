APP_NAME=go-rest-template
APP_ENV=development
APP_SHUTDOWN_TIMEOUT=10s

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=30s

AUTH_SECRET=change-me-in-production
AUTH_ISSUER=go-rest-template
AUTH_TOKEN_TTL=24h
AUTH_BCRYPT_COST=12

DATABASE_DRIVER=sqlite
DATABASE_URL=postgres://postgres:postgres@localhost:5432/go_rest_template?sslmode=disable
DATABASE_MIGRATIONS_DIR=
SQLITE_PATH=data/app.db
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_CONN_MAX_LIFETIME=1h
AUTO_MIGRATE=true

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

OPENAPI_SPEC_PATH=api/openapi.yaml
OPENAPI_VALIDATE_REQUESTS=true
OPENAPI_VALIDATE_RESPONSES=true
OPENAPI_SERVE_DOCUMENTATION=true

LOG_LEVEL=INFO
ENABLE_PPROF=false