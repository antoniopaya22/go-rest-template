# Generated by `make generate`. Do not edit by hand.
# Copy to .env to override values locally; real environment variables win over the file.

# --- Application ---
# Service name used in logs, token issuer and traces.
APP_NAME=go-rest-template
# Runtime environment. Production tightens defaults and refuses insecure settings. One of: development, production.
APP_ENV=development
# Maximum time to wait for in-flight requests on shutdown.
APP_SHUTDOWN_TIMEOUT=10s

# --- HTTP server ---
# Interface the API listens on.
HTTP_HOST=0.0.0.0
# Port the API listens on.
HTTP_PORT=8080
# Maximum time to read a request, including the body.
HTTP_READ_TIMEOUT=5s
# Maximum time to write a response.
HTTP_WRITE_TIMEOUT=10s
# Maximum time to keep an idle keep-alive connection open.
HTTP_IDLE_TIMEOUT=1m0s
# Deadline applied to the context of every request.
HTTP_REQUEST_TIMEOUT=30s
# Number of reverse proxies in front of the API whose X-Forwarded-For entries are trusted. 0 uses the TCP peer address.
HTTP_TRUSTED_PROXIES=0
# Maximum accepted request body size in bytes.
HTTP_MAX_BODY_BYTES=1048576
# Comma-separated origins allowed by CORS. Use explicit origins in production.
HTTP_CORS_ALLOWED_ORIGINS=*

# --- Admin server ---
# Interface the admin server (metrics, profiling) listens on. Keep it off the public network.
ADMIN_HOST=0.0.0.0
# Port of the admin server. 0 disables it.
ADMIN_PORT=9090
# Expose net/http/pprof under /debug/pprof on the admin server.
ADMIN_PPROF_ENABLED=false

# --- Authentication ---
# Access token signing algorithm. EdDSA publishes the public key at /.well-known/jwks.json. One of: HS256, EdDSA.
AUTH_ALGORITHM=HS256
# HMAC signing key for HS256. At least 32 characters in production.
AUTH_SECRET=change-me-in-production
# Path to a PEM-encoded PKCS#8 Ed25519 private key. Required for EdDSA.
AUTH_PRIVATE_KEY_FILE=
# Value of the iss claim. Defaults to APP_NAME.
AUTH_ISSUER=go-rest-template
# Lifetime of access tokens.
AUTH_ACCESS_TOKEN_TTL=15m0s
# Lifetime of refresh tokens.
AUTH_REFRESH_TOKEN_TTL=720h0m0s
# bcrypt work factor, between 10 and 16.
AUTH_BCRYPT_COST=12
# Allow anonymous callers to create regular user accounts.
AUTH_REGISTRATION_ENABLED=true

# --- Database ---
# Database backend. Defaults to sqlite in development and postgres in production. One of: sqlite, postgres.
DATABASE_DRIVER=sqlite
# PostgreSQL connection string. Required when DATABASE_DRIVER=postgres.
DATABASE_URL=
# SQLite database file. Used when DATABASE_DRIVER=sqlite.
SQLITE_PATH=data/app.db
# Apply pending migrations at startup.
DATABASE_AUTO_MIGRATE=true
# Maximum open connections (PostgreSQL).
DATABASE_MAX_OPEN_CONNS=20
# Maximum idle connections (PostgreSQL).
DATABASE_MAX_IDLE_CONNS=5
# Maximum time a connection may stay idle (PostgreSQL).
DATABASE_CONN_MAX_IDLE_TIME=5m0s
# Maximum time a connection may be reused (PostgreSQL).
DATABASE_CONN_MAX_LIFETIME=1h0m0s

# --- Bootstrap ---
# Create an administrator at startup when none exists.
BOOTSTRAP_ADMIN_ENABLED=false
# Username of the bootstrap administrator.
BOOTSTRAP_ADMIN_USERNAME=
# First name of the bootstrap administrator.
BOOTSTRAP_ADMIN_FIRST_NAME=
# Last name of the bootstrap administrator.
BOOTSTRAP_ADMIN_LAST_NAME=
# Password of the bootstrap administrator, at least 12 characters.
BOOTSTRAP_ADMIN_PASSWORD=

# --- OpenAPI ---
# Reject requests that do not match the OpenAPI contract.
OPENAPI_VALIDATE_REQUESTS=true
# Fail responses that do not match the contract. Buffers every response, so it defaults to true in development and false in production.
OPENAPI_VALIDATE_RESPONSES=true
# Serve the interactive API reference at /docs.
OPENAPI_DOCS_ENABLED=true

# --- Rate limiting ---
# Throttle requests per client IP.
RATE_LIMIT_ENABLED=true
# Requests allowed per client IP in each window.
RATE_LIMIT_REQUESTS=100
# Length of the rate limit window.
RATE_LIMIT_WINDOW=1m0s
# Login and token refresh attempts allowed per client IP in each window.
RATE_LIMIT_LOGIN_REQUESTS=10

# --- Logging ---
# Minimum level of emitted log records. One of: DEBUG, INFO, WARN, ERROR.
LOG_LEVEL=INFO
# Log encoding. auto selects text in development and json in production. One of: auto, text, json.
LOG_FORMAT=auto

# --- Metrics ---
# Expose Prometheus metrics at /metrics on the admin server.
METRICS_ENABLED=true

# --- Tracing ---
# Export OpenTelemetry traces over OTLP/HTTP. The endpoint is set with OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_ENABLED=false
# Service name reported in traces. Defaults to APP_NAME.
OTEL_SERVICE_NAME=go-rest-template
